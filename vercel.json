{
  "cleanUrls": true,
  "headers": [
    {"source": "/assets/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400"}]},
    {"source": "/vendor/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/game.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/(.*).glb", "headers": [{"key": "Content-Type", "value": "model/gltf-binary"}]},
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ]
}
